# Kernel build configuration for Xiaomi Mi 9 Lite (pyxis / SDM710)
# Target: ARMv8.0-A (non-PAC / pure ARM64)

CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_NATIVE_RAM_BLOCK=y
CONFIG_XNU_VERIFIED_ROOT_PROBE=y
CONFIG_XNU_OWNER_ROOT_AUDIT=y
CONFIG_XNU_OWNER_ROOT_TRUST=y
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_ZONE_PGZ_ALIGNMENT_PROBE=y
CONFIG_XNU_BOOT_PROGRESS=y
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=y
CONFIG_XNU_EXTRA_LD_ARCHIVES=""
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_ARMVIRT_PLATFORM=n

# Pure ARM64 (disable mandatory ARMv8.3 PAC traps)
CONFIG_ARM64_V8_0=y
CONFIG_ARM64E_DISABLED=y
CONFIG_XNU_DISABLE_PAN=y

# Memory & CPU
CONFIG_MAX_CPUS=8
CONFIG_NUM_CLUSTERS=2
CONFIG_DRAM_BASE=0x80000000
CONFIG_DRAM_SIZE=0x180000000

# Console & Diagnostics
CONFIG_EARLY_PRINTK=y
CONFIG_EARLY_UART_QUPV3=y
CONFIG_EARLY_UART_BASE=0x008C0000
